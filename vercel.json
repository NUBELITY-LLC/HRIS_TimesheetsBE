{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/v1/jobs/timesheet-reminders", "schedule": "0 15 * * 1" },
    { "path": "/api/v1/jobs/notification-emails", "schedule": "0 16 * * *" }
  ]
}
